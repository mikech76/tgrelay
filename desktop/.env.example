# =============================================================================
#  tgrelay — настройки
# =============================================================================
#  Всё в одном файле. После изменений перезапустите программу.
#  Всё, что идёт после " #" в строке, считается комментарием.
#  Строки, начинающиеся с #, игнорируются.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. ПРОКСИ
# -----------------------------------------------------------------------------
#  HTTP CONNECT-прокси, через которые пойдёт трафик Telegram.
#  По одному прокси на строку. Формат:
#
#      PROXY=логин:пароль@хост:порт
#
#  Если у прокси нет логина и пароля:
#
#      PROXY=хост:порт
#
#  Строк PROXY= может быть сколько угодно: программа перебирает их
#  и выбирает рабочий. Чем больше прокси, тем стабильнее.
#
#  Чтобы временно отключить прокси, поставьте # в начало строки.
#  В конце строки можно оставить пояснение после " #".
#
#  Примеры (скопируйте строку, уберите # и подставьте свои данные):
#
#  PROXY=user:password@1.2.3.4:9405        # основной
#  PROXY=user:password@5.6.7.8:9829        # запасной
#  PROXY=9.9.9.9:8080                      # без авторизации
#
#  Старый формат одной строкой тоже поддерживается:
#  PROXIES=user:pass@1.2.3.4:9405;5.6.7.8:8080

PROXY=


# -----------------------------------------------------------------------------
#  2. ПОРТЫ
# -----------------------------------------------------------------------------
#  Порт MTProto-прокси. Этот же порт указывается в Telegram
#  при добавлении прокси типа «MTProto». По умолчанию 55055.
PROXY_PORT=55055

#  Порт SOCKS5-прокси. Указывается в Telegram при добавлении
#  прокси типа «SOCKS5». По умолчанию 55056.
SOCKS_PORT=55056

#  На каком адресе слушать SOCKS5:
#    127.0.0.1  — только этот компьютер (безопаснее);
#    0.0.0.0    — ещё и другие устройства в локальной сети.
SOCKS_HOST=0.0.0.0


# -----------------------------------------------------------------------------
#  3. СЕКРЕТ MTProto
# -----------------------------------------------------------------------------
#  Ключ, которым Telegram шифрует соединение с MTProto-прокси.
#  Ровно 32 символа из 0-9 и a-f (16 байт).
#
#  Если оставить пустым, программа при первом запуске предложит
#  сгенерировать ключ и сама запишет его сюда.
#
#  Сгенерировать вручную:
#      python -c "import secrets; print(secrets.token_hex(16))"
#
#  ВАЖНО: если поменять ключ, в Telegram нужно заново добавить прокси.
SECRET=


# -----------------------------------------------------------------------------
#  4. ВНЕШНЕЕ ИМЯ (только если пробросили порт на роутере)
# -----------------------------------------------------------------------------
#  DDNS-имя или внешний IP компьютера. Нужно, чтобы ссылки для Telegram
#  были с внешним адресом, а не с локальным.
#
#  Пример: yourname.duckdns.org
#
#  Если пусто — в ссылках будет локальный адрес компьютера,
#  и прокси будет работать только в своей сети.
EXTERNAL_HOST=


# -----------------------------------------------------------------------------
#  5. ДОСТУП К SOCKS5
# -----------------------------------------------------------------------------
#  Адреса, которым SOCKS5 разрешает подключаться без пароля.
#  По умолчанию: сам компьютер и локальная сеть.
#
#  Формат: список сетей через запятую (CIDR).
#  Пусто — пароль требуется всем.
AUTH_BYPASS=127.0.0.1/32,192.168.0.0/24

#  Логин и пароль для всех остальных (например, для подключения из интернета).
#  Если оба пустые — авторизация выключена, и пускаются все адреса.
#
#  ВАЖНО: перед пробросом порта наружу обязательно задайте пароль,
#  иначе ваш SOCKS5 станет открытым прокси для всего интернета.
SOCKS_USER=
SOCKS_PASS=


# -----------------------------------------------------------------------------
#  6. СЛУЖЕБНОЕ
# -----------------------------------------------------------------------------
#  Адреса Telegram, по которым проверяется живость прокси из пула.
#  Менять не нужно.
TEST_TARGET=149.154.167.51:443,149.154.175.50:443
