# Скопируйте в .env и заполните своими значениями.

# --- MTProto-прокси (тип MTProto в Telegram) ---
PROXY_PORT=55055
# Секрет: 32 hex-символа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(16))"
SECRET=

# --- SOCKS5-конвертер (тип SOCKS5 в Telegram) ---
SOCKS_HOST=0.0.0.0
SOCKS_PORT=55056
# Кому можно без пароля. Пусто = всем (тогда обязательно задайте логин/пароль).
AUTH_BYPASS=127.0.0.1/32,192.168.0.0/24
SOCKS_USER=
SOCKS_PASS=

# --- Пул HTTP CONNECT-прокси ---
# Формат: user:pass@host:port;host:port;...
# Прокси, которые не нужны, удалите.
PROXIES=

# --- Необязательно ---
# Внешнее имя (DDNS), если нужен доступ из других сетей.
# Пример: yourname.duckdns.org
EXTERNAL_HOST=

# Хосты Telegram для проверки живости прокси
TEST_TARGET=149.154.167.51:443,149.154.175.50:443
