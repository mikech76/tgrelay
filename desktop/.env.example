# Скопируйте этот файл в .env и заполните своими значениями.
# Всё настраивается здесь: прокси, порты, внешнее имя.

# =====================================================================
# 1. ПРОКСИ (HTTP CONNECT)
# =====================================================================
# Формат: user:pass@host:port;host:port;...
# Если прокси без логина — просто host:port.
PROXIES=

# =====================================================================
# 2. ПОРТЫ
# =====================================================================
# MTProto (тип «MTProto» в Telegram)
PROXY_PORT=55055
# SOCKS5 (тип «SOCKS5» в Telegram)
SOCKS_PORT=55056
# На каком адресе слушать. 127.0.0.1 — только этот компьютер,
# 0.0.0.0 — ещё и устройства в локальной сети.
SOCKS_HOST=0.0.0.0

# =====================================================================
# 3. СЕКРЕТ MTProto
# =====================================================================
# 32 hex-символа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(16))"
# Если оставить пустым — сгенерируется случайный при каждом запуске,
# и ссылку придётся брать заново.
SECRET=

# =====================================================================
# 4. ВНЕШНЕЕ ИМЯ (только если пробросили порт на роутере)
# =====================================================================
# DDNS-имя или внешний IP. Пример: yourname.duckdns.org
# Если пусто — в ссылках будет локальный адрес компьютера.
EXTERNAL_HOST=

# =====================================================================
# 5. ДОСТУП К SOCKS5
# =====================================================================
# Кому можно без пароля (локальные адреса). Пусто — всем, но тогда
# обязательно задайте логин и пароль ниже.
AUTH_BYPASS=127.0.0.1/32,192.168.0.0/24
SOCKS_USER=
SOCKS_PASS=

# =====================================================================
# 6. СЛУЖЕБНОЕ
# =====================================================================
# Адреса Telegram для проверки живости прокси
TEST_TARGET=149.154.167.51:443,149.154.175.50:443
